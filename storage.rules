rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // /products/** — product artwork used by the storefront.
    // Images are public (they render on the public catalog).
    // Write access is restricted to authenticated users uploading image
    // files under 5 MB.
    //
    // NOTE: These rules use Firebase Auth identity but not the admin role
    // (Storage rules cannot read Firestore). To restrict uploads to the
    // admin account only, set a custom claim (`admin: true`) on that user
    // and replace the write condition with:
    //   allow write: if request.auth.token.admin == true;
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}